---
import Range from './Range.astro';
import { RV, rovDefaults, rovDefs, rovSummary, rovSvg, solveRov } from '../lib/views/rov-view';
const s = rovDefaults;
const sol = solveRov(s);
const sum = rovSummary(s, sol);
---
<div class="tool-body rov">
  <div class="tool-view">
    <svg class="rov-svg" viewBox={`0 0 ${RV.w} ${RV.h}`} role="img" aria-label="Cross-section of a cylindrical pressure housing with water pressure acting inward on the wall.">
      <Fragment set:html={rovDefs()} />
      <g data-rov set:html={rovSvg(s, sol)} />
    </svg>
    <div class="depth-control">
      <Range id="r-depth" label="Depth" min={0} max={300} step={1} value={s.depth} unit="m" />
      <p class="pressure" aria-live="polite"><strong data-out="pressure">{sum.pressure}</strong> <span data-out="atm">{sum.atm}</span></p>
    </div>
    <p class={`verdict${sum.failed ? ' bad' : ''}`} data-out="status" role="status">{sum.status}</p>
  </div>
  <div class="tool-controls">
    <h4>Housing</h4>
    <ul class="checks" aria-live="polite">
      {sum.checks.map((c, k) => (
        <li class={`${c.ok ? '' : 'bad'}${c.governs ? ' governs' : ''}`} data-check={k}>
          <p><span>{c.name}</span><strong data-out="v">{c.value}</strong></p>
          <div class="meter-track"><div class="meter-fill" style={`width:${c.pct.toFixed(1)}%`}></div></div>
        </li>
      ))}
    </ul>
    <p class="note">Safety factors. Below 1.00 the housing fails. Crush depth for this tube: <strong data-out="crush">{sum.crush}</strong>.</p>
    <Range id="r-dia" label="Tube outer diameter" min={60} max={160} step={2} value={s.diameterMm} unit="mm" />
    <Range id="r-wall" label="Wall thickness" min={2} max={12} step={0.5} value={s.wallMm} unit="mm" decimals={1} />
    <Range id="r-cap" label="End cap thickness" min={4} max={30} step={1} value={s.capMm} unit="mm" />
    <h4>Trim</h4>
    <Range id="r-mass" label="Vehicle mass" min={2} max={12} step={0.1} value={s.massKg} unit="kg" decimals={1} />
    <Range id="r-extra" label="Other displaced volume" min={0} max={10} step={0.1} value={s.extraLitres} unit="L" decimals={1} />
    <p class="outline"><strong data-out="net">{sum.net}</strong><span data-out="ballast">{sum.ballast}</span></p>
    <h4>Motion</h4>
    <Range id="r-speed" label="Speed through the water" min={0} max={1.5} step={0.05} value={s.speed} unit="m/s" decimals={2} />
    <p class="outline"><strong data-out="drag">{sum.drag}</strong><span data-out="power">{sum.power}</span><span data-out="tether">{sum.tether}</span></p>
  </div>
</div>
